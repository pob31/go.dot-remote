<!-- Dark only: the window behind Compose is Go.dot's ground, so no white flash at launch. -->
<resources>
    <style name="Theme.GodotRemote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/title_bar</item>
        <item name="android:navigationBarColor">@color/title_bar</item>
    </style>
</resources>
